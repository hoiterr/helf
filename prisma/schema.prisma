// helf — canonical health-data + planning schema
//
// Runs on SQLite out of the box (zero-config local dev: `npm run dev` creates and
// migrates a local file DB — no Postgres to install). The schema is deliberately
// portable: no DB-level enums, scalar-list, or Json columns, so the SAME schema
// also runs on PostgreSQL in production by switching `provider`/`url` below.
// Enum-like fields are plain strings (TS unions in src/domain/enums.ts); JSON
// payloads (`raw`, `steps`, `scopes`) are stored as serialized strings.
//
// Every provider (Whoop, Oura, Polar, Garmin-later…) normalizes INTO these tables;
// product/analytics code reads only from here and never knows the source device.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev default: SQLite (file:./dev.db). For production, set
  // provider = "postgresql" and DATABASE_URL to your Postgres connection string.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Core ──────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections      ProviderConnection[]
  sleepSessions    SleepSession[]
  recoveries       DailyRecovery[]
  workouts         Workout[]
  dailySummaries   DailySummary[]
  hrvSamples       HrvSample[]
  workoutTemplates WorkoutTemplate[]
  plannedWorkouts  PlannedWorkout[]
}

/// A user's linked account at one provider. Holds the OAuth tokens (encrypted at
/// rest) and the provider-side user id used to match incoming webhooks.
model ProviderConnection {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  /// Provider enum value (see src/domain/enums.ts Provider).
  provider       String
  /// ConnectionStatus enum value.
  status         String    @default("ACTIVE")
  // Provider's own id for this user (webhooks reference this, not our userId)
  externalUserId String?
  /// OAuth scopes, stored as a JSON-encoded string array.
  scopes         String?
  // Tokens are AES-256-GCM encrypted blobs — never stored in plaintext.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([provider, externalUserId])
}

// ── Canonical metrics ─────────────────────────────────────────────────────────

/// One night of sleep, normalized across providers.
model SleepSession {
  id         String @id @default(uuid())
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  source     String
  externalId String

  start           DateTime
  end             DateTime
  timezoneOffset  Int?
  totalSleepMin   Int?
  timeInBedMin    Int?
  efficiencyPct   Float?
  lightMin        Int?
  deepMin         Int?
  remMin          Int?
  awakeMin        Int?
  avgHeartRate    Float?
  avgHrvRmssd     Float?
  respiratoryRate Float?
  sleepScore      Float?

  /// Original provider payload, JSON-encoded (audit / re-normalization).
  raw       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([userId, start])
}

/// Daily recovery / readiness snapshot — the morning "how ready am I" metrics.
model DailyRecovery {
  id         String @id @default(uuid())
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  source     String
  externalId String

  /// Calendar day this recovery applies to (UTC midnight).
  date             DateTime
  score            Float?
  restingHeartRate Float?
  hrvRmssd         Float?
  spo2Pct          Float?
  skinTempCelsius  Float?
  respiratoryRate  Float?

  raw       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([userId, source, date])
  @@index([userId, date])
}

/// A workout / activity, normalized across providers.
model Workout {
  id         String @id @default(uuid())
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  source     String
  externalId String

  sportType      String?
  start          DateTime
  end            DateTime
  durationMin    Float?
  avgHeartRate   Float?
  maxHeartRate   Float?
  calories       Float?
  distanceMeters Float?
  strain         Float?
  load           Float?

  raw       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when this completed workout has been reconciled against a planned session.
  plannedWorkout PlannedWorkout?

  @@unique([source, externalId])
  @@index([userId, start])
}

/// Daily rollup of all-day metrics (steps, calories, resting HR).
model DailySummary {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  source String

  date             DateTime
  steps            Int?
  activeCalories   Float?
  totalCalories    Float?
  restingHeartRate Float?
  avgStressLevel   Float?

  raw       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source, date])
  @@index([userId, date])
}

/// Optional high-resolution HRV samples (e.g. Oura's 5-min nightly intervals).
model HrvSample {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  source String

  recordedAt DateTime
  rmssd      Float

  @@unique([userId, source, recordedAt])
  @@index([userId, recordedAt])
}

// ── Planning ──────────────────────────────────────────────────────────────────

/// A reusable session definition the user (or the system) can drop onto any day.
/// `userId == null` marks a built-in/global template.
model WorkoutTemplate {
  id                   String  @id @default(uuid())
  user                 User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String?
  title                String
  sportType            String
  /// Intensity enum value.
  intensity            String  @default("MODERATE")
  estimatedDurationMin Int?
  estimatedLoad        Float?
  description          String?
  /// Structured steps, JSON-encoded — see WorkoutStep type.
  steps                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planned PlannedWorkout[]

  @@index([userId])
}

/// A session scheduled on a specific day. Auto-reconciles to a completed Workout
/// once the matching device activity is ingested.
model PlannedWorkout {
  id                   String   @id @default(uuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  /// Scheduled calendar day, normalized to UTC midnight.
  date                 DateTime
  title                String
  sportType            String
  /// Intensity enum value.
  intensity            String   @default("MODERATE")
  estimatedDurationMin Int?
  estimatedLoad        Float?
  notes                String?
  /// Structured steps, JSON-encoded — see WorkoutStep type.
  steps                String?
  /// PlannedStatus enum value.
  status               String   @default("PLANNED")
  /// Ordering within a day (drag-to-reorder).
  order                Int      @default(0)

  template   WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  /// The actual completed activity this plan was fulfilled by, once reconciled.
  completedWorkout   Workout? @relation(fields: [completedWorkoutId], references: [id], onDelete: SetNull)
  completedWorkoutId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, status])
}
